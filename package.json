{
  "name": "renewvan-apps",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "core:test": "pnpm --filter @renewvan/core test",
    "core:typecheck": "pnpm --filter @renewvan/core typecheck",
    "dashboard:dev": "pnpm --filter dashboard dev",
    "dashboard:build": "pnpm --filter dashboard build",
    "dashboard:test": "pnpm --filter dashboard test",
    "dashboard:check": "pnpm --filter dashboard exec vp check",
    "mobile:start": "pnpm --filter mobile start",
    "mobile:android": "pnpm --filter mobile android",
    "mobile:typecheck": "pnpm --filter mobile typecheck",
    "mobile:lint": "pnpm --filter mobile lint",
    "mobile:test": "pnpm --filter mobile test",
    "test": "pnpm core:test && pnpm dashboard:test && pnpm mobile:test",
    "check": "pnpm core:typecheck && pnpm dashboard:check && pnpm mobile:typecheck && pnpm mobile:lint",
    "prepare": "vp config --no-agent"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  }
}
