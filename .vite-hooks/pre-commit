# One pre-commit hook for the workspace (installed by `vp config`, the root `prepare` script). Each
# app runs its type checks and tests only when the commit touches it or what it depends on
# (packages/, the root manifests).
staged="$(git diff --cached --name-only --diff-filter=ACMR)"
touches() { printf '%s\n' "$staged" | grep -qE "$1"; }
shared='^(packages/|package\.json$|pnpm-lock\.yaml$|pnpm-workspace\.yaml$|\.pnpmfile\.cjs$)'

# Oxlint and Oxfmt on every staged file, in every app (root vite.config.ts `staged`).
vp staged

# The shared package: everything under packages/ and the root manifests it is installed from.
if touches "$shared"; then
  pnpm --filter @renewvan/core typecheck
  pnpm --filter @renewvan/core test
fi

if touches '^dashboard/' || touches "$shared"; then
  pnpm --filter dashboard typecheck
  pnpm --filter dashboard test
fi

if touches '^mobile/' || touches "$shared"; then
  (cd mobile && pnpm typecheck && pnpm test)
fi
