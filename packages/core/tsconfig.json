{
  // Pure TypeScript shipped as source: each app compiles it with its own settings (mobile strict,
  // the dashboard with verbatimModuleSyntax), so this is the strictest of both.
  "compilerOptions": {
    "target": "es2023",
    // ES2022, not newer: the phone app runs this in Hermes, which lacks ES2023 array methods
    // (`toSorted`, `findLastIndex`...) that Node and browsers have, so they must not type-check here.
    "lib": ["ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [],
    "skipLibCheck": true,
    "noEmit": true,
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
